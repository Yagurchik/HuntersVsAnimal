  displayName: "\u041A\u043E\u043B\u043E\u043A\u043E\u043B\u044C\u0449\u0438\u043A"
  summary: "\u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u044B\u0439
    \u0431\u043E\u0441\u0441 2\xD72. \u0415\u0441\u043B\u0438 \u0435\u0433\u043E
    \u0443\u0434\u0430\u0440\u0438\u043B\u0438 \u0438 \u043E\u043D \u043F\u0435\u0440\u0435\u0436\u0438\u043B
    \u0437\u0430\u043B\u043F, \u0432\u0441\u0435 \u043E\u0431\u044B\u0447\u043D\u044B\u0435
    \u0432\u0440\u0430\u0433\u0438 \u0432 \u043A\u043E\u043C\u043D\u0430\u0442\u0435
    \u0441\u0440\u0430\u0437\u0443 \u0434\u0435\u043B\u0430\u044E\u0442 \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
    \u0448\u0430\u0433. \u0421\u043C\u0435\u0440\u0442\u044C \u0431\u043E\u0441\u0441\u0430
    \u043E\u0442\u043C\u0435\u043D\u044F\u0435\u0442 \u044D\u0442\u043E\u0442 \u0448\u0430\u0433."

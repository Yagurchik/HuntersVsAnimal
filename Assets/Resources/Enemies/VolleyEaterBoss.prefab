  m_Name: 
  m_EditorClassIdentifier: 
  enemyTypeId: volley_eater_boss
  displayName: "\u041F\u043E\u0436\u0438\u0440\u0430\u0442\u0435\u043B\u044C \u0437\u0430\u043B\u043F\u0430"
  summary: "\u0423\u043D\u0438\u0432\u0435\u0440\u0441\u0430\u043B\u044C\u043D\u044B\u0439
    \u0431\u043E\u0441\u0441 2\xD72. \u041F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E
    \u0441\u044A\u0435\u0434\u0430\u0435\u0442 \u043F\u0435\u0440\u0432\u044B\u0439
    \u0437\u0430\u043B\u043F, \u043A\u043E\u0442\u043E\u0440\u044B\u0439 \u0432 \u043D\u0435\u0433\u043E
    \u043F\u043E\u043F\u0430\u043B, \u0438 \u043B\u0435\u0447\u0438\u0442\u0441\u044F
    \u043D\u0430 3% \u043C\u0430\u043A\u0441\u0438\u043C\u0430\u043B\u044C\u043D\u043E\u0433\u043E
    HP \u0437\u0430 \u043A\u0430\u0436\u0434\u044B\u0439 \u043F\u0440\u043E\u0433\u043B\u043E\u0447\u0435\u043D\u043D\u044B\u0439
    \u0441\u043D\u0430\u0440\u044F\u0434. \u0421\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0435
    \u0437\u0430\u043B\u043F\u044B \u043D\u0430\u043D\u043E\u0441\u044F\u0442 \u043E\u0431\u044B\u0447\u043D\u044B\u0439
    \u0443\u0440\u043E\u043D."

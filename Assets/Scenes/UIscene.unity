--- !u!114 &1182272565
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1182272563}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d15edf97fa82d43408bc8472c1ab5be6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  section: 1
  entryTitle: "\u041B\u0438\u0441\u0442\u043E\u0435\u0434"
  entrySubtitle: "\u0421\u0443\u043C\u0435\u0440\u0435\u0447\u043D\u0430\u044F \u0447\u0430\u0449\u0430 
    \xB7  \u0421\u041F\u0415\u0426\u0418\u0410\u041B\u0418\u0421\u0422"
  entryBody: "\u0420\u044F\u0434\u043E\u043C \u0441 \u0441\u043E\u044E\u0437\u043D\u0438\u043A\u043E\u043C
    \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 \u043D\u0430 20% \u043C\u0435\u043D\u044C\u0448\u0435
    \u043F\u0440\u044F\u043C\u043E\u0433\u043E \u0443\u0440\u043E\u043D\u0430.\n\n\u041E\u0421\u041E\u0411\u0415\u041D\u041D\u041E\u0421\u0422\u042C\n\u041F\u043E\u043A\u0430
    \u0440\u044F\u0434\u043E\u043C \u0435\u0441\u0442\u044C \u0434\u0440\u0443\u0433\u043E\u0439
    \u043E\u0431\u044B\u0447\u043D\u044B\u0439 \u0432\u0440\u0430\u0433, \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442
    \u043D\u0430 20% \u043C\u0435\u043D\u044C\u0448\u0435 \u043F\u0440\u044F\u043C\u043E\u0433\u043E
    \u0443\u0440\u043E\u043D\u0430. \u041E\u0433\u043E\u043D\u044C \u0438 \u044F\u0434
    \u0434\u0435\u0439\u0441\u0442\u0432\u0443\u044E\u0442 \u043F\u043E\u043B\u043D\u043E\u0441\u0442\u044C\u044E.\n\n\u041E\u0411\u042B\u0427\u041D\u042B\u0419
    \u0412\u0420\u0410\u0413\n\u0420\u0430\u0437\u043C\u0435\u0440 \u043D\u0430 \u043F\u043E\u043B\u0435:
    1\xD71\n\u0411\u0430\u0437\u043E\u0432\u043E\u0435 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435:
    100\n\n\u0417\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u0440\u0430\u0441\u0442\u0451\u0442
    \u0441 \u0443\u0440\u043E\u0432\u043D\u0435\u043C \u0438 \u0432\u043E\u043B\u043D\u043E\u0439."
  portrait: {fileID: 21300000, guid: 23d2abc2a66a4b39aa539cfebdf6fb54, type: 3}

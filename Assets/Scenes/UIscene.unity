--- !u!114 &299689301
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 299689299}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d15edf97fa82d43408bc8472c1ab5be6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  section: 1
  entryTitle: "\u0421\u043D\u0435\u0436\u043D\u044B\u0439 \u0447\u0435\u0440\u0435\u043F"
  entrySubtitle: "\u0421\u043D\u0435\u0436\u043D\u0430\u044F \u043C\u0433\u043B\u0430 
    \xB7  \u0420\u042F\u0414\u041E\u0412\u041E\u0419"
  entryBody: "\u041E\u0433\u043E\u043D\u044C \u0441\u043D\u0438\u043C\u0430\u0435\u0442
    \u0441\u043D\u0435\u0436\u043D\u044B\u0439 \u043F\u043E\u043A\u0440\u043E\u0432.
    \u0427\u0435\u0440\u0435\u0437 \u0434\u0432\u0430 \u0445\u043E\u0434\u0430 \u0431\u0435\u0437
    \u043E\u0433\u043D\u044F \u043E\u043D \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F.\n\n\u041E\u0421\u041E\u0411\u0415\u041D\u041D\u041E\u0421\u0422\u042C\n\u041E\u0433\u043E\u043D\u044C
    \u0441\u043D\u0438\u043C\u0430\u0435\u0442 \u0441\u043D\u0435\u0433. \u0417\u0430\u043C\u0451\u0440\u0437\u0448\u0430\u044F
    \u0444\u043E\u0440\u043C\u0430 \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
    \u043F\u043E\u0441\u043B\u0435 \u0434\u0432\u0443\u0445 \u0445\u043E\u0434\u043E\u0432
    \u0431\u0435\u0437 \u043D\u043E\u0432\u043E\u0433\u043E \u043E\u0433\u043D\u0435\u043D\u043D\u043E\u0433\u043E
    \u0443\u0440\u043E\u043D\u0430.\n\n\u041E\u0411\u042B\u0427\u041D\u042B\u0419
    \u0412\u0420\u0410\u0413\n\u0420\u0430\u0437\u043C\u0435\u0440 \u043D\u0430 \u043F\u043E\u043B\u0435:
    1\xD71\n\u0411\u0430\u0437\u043E\u0432\u043E\u0435 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435:
    100\n\n\u0417\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u0440\u0430\u0441\u0442\u0451\u0442
    \u0441 \u0443\u0440\u043E\u0432\u043D\u0435\u043C \u0438 \u0432\u043E\u043B\u043D\u043E\u0439."
  portrait: {fileID: 21300000, guid: 1e85cd413a544f2b8ddffd3a9d0367ad, type: 3}

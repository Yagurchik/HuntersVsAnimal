--- !u!114 &1188093771
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1188093769}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d15edf97fa82d43408bc8472c1ab5be6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  section: 1
  entryTitle: "\u0411\u043E\u043B\u043E\u0442\u043D\u044B\u0439 \u0434\u0435\u043C\u043E\u043D"
  entrySubtitle: "\u0422\u043E\u043F\u044C \u0443\u0442\u043E\u043F\u043B\u0435\u043D\u043D\u0438\u043A\u043E\u0432 
    \xB7  \u0420\u042F\u0414\u041E\u0412\u041E\u0419"
  entryBody: "\u0420\u044F\u0434\u043E\u0432\u043E\u0439 \u0432\u0440\u0430\u0433
    \u0422\u043E\u043F\u0435\u0439. \u041D\u0435\u0432\u043E\u0441\u043F\u0440\u0438\u0438\u043C\u0447\u0438\u0432
    \u043A \u044F\u0434\u0443; \u043F\u0440\u0438 \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0438
    \u0440\u0430\u0437\u0431\u0440\u044B\u0437\u0433\u0438\u0432\u0430\u0435\u0442
    \u0431\u043E\u043B\u043E\u0442\u043D\u0443\u044E \u0436\u0438\u0436\u0443.\n\n\u041E\u0411\u042B\u0427\u041D\u042B\u0419
    \u0412\u0420\u0410\u0413\n\u0420\u0430\u0437\u043C\u0435\u0440 \u043D\u0430 \u043F\u043E\u043B\u0435:
    1\xD71\n\u0411\u0430\u0437\u043E\u0432\u043E\u0435 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435:
    100\n\u0418\u043C\u043C\u0443\u043D\u0438\u0442\u0435\u0442 \u043A \u044F\u0434\u0443\n\n\u0417\u0434\u043E\u0440\u043E\u0432\u044C\u0435
    \u0440\u0430\u0441\u0442\u0451\u0442 \u0441 \u0443\u0440\u043E\u0432\u043D\u0435\u043C
    \u0438 \u0432\u043E\u043B\u043D\u043E\u0439."
  portrait: {fileID: 21300000, guid: 4d48b90d11f04528a5f8f2587d3e6c39, type: 3}

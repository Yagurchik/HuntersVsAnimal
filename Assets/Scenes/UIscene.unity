    \u0438\u043C\u0435\u044E\u0442 \u0437\u0430\u043C\u0451\u0440\u0437\u0448\u0443\u044E
    \u0438 \u043E\u0442\u0442\u0430\u044F\u0432\u0448\u0443\u044E \u0444\u043E\u0440\u043C\u044B.
    \u041E\u0433\u043E\u043D\u044C \u0440\u0430\u0441\u0442\u0430\u043F\u043B\u0438\u0432\u0430\u0435\u0442
    \u043F\u043E\u043A\u0440\u043E\u0432; \u0447\u0435\u0440\u0435\u0437 \u0434\u0432\u0430
    \u0445\u043E\u0434\u0430 \u0431\u0435\u0437 \u043D\u043E\u0432\u043E\u0433\u043E
    \u043E\u0433\u043D\u044F \u043E\u043D \u0432\u043E\u0437\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F.\n\n\u041E\u0411\u042B\u0427\u041D\u042B\u0415
    \u0412\u0420\u0410\u0413\u0418\n\u0421\u043D\u0435\u0436\u043D\u044B\u0439 \u0447\u0435\u0440\u0435\u043F 
    \xB7  \u041B\u0435\u0434\u043E\u043B\u043E\u0431  \xB7  \u0412\u044C\u044E\u0436\u043D\u044B\u0439
    \u0434\u0443\u0445  \xB7  \u0418\u043D\u0435\u0435\u0432\u0438\u043A  \xB7  \u0421\u043D\u0435\u0433\u043E\u0432\u043E\u0439
    \u0434\u0432\u043E\u0439\u043D\u0438\u043A\n\n\u0411\u041E\u0421\u0421\u042B
    \u0418 \u041C\u0418\u041D\u0418-\u0411\u041E\u0421\u0421\u042B\n\u0423\u0437\u043B\u043E\u0432\u0438\u043A 
    \xB7  \u041A\u043E\u0441\u0442\u044F\u043D\u043E\u0439 \u044D\u043B\u044C\u0444 
    \xB7  \u0421\u0430\u043C\u043E\u0437\u0432\u0430\u043D\u0435\u0446  \xB7  \u041A\u043E\u043B\u043E\u043A\u043E\u043B\u044C\u0449\u0438\u043A 
    \xB7  \u041F\u043E\u0436\u0438\u0440\u0430\u0442\u0435\u043B\u044C \u0437\u0430\u043B\u043F\u0430\n\n\u041A\u0430\u0436\u0434\u044B\u0439
    \u0443\u0440\u043E\u0432\u0435\u043D\u044C \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442
    \u0447\u0435\u0442\u044B\u0440\u0435 \u043B\u0438\u043D\u0438\u0438 \u043E\u0431\u043E\u0440\u043E\u043D\u044B.
    \u041D\u0430 \u043B\u0438\u043D\u0438\u044F\u0445 2\u20134 \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u0435
    \u0441\u043B\u0430\u0431\u0435\u0435; \u0421\u0432\u0435\u0442\u043B\u044F\u0447\u043E\u043A
    \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0442\u0451\u043C\u043D\u044B\u0435
    \u043A\u043B\u0435\u0442\u043A\u0438."
  portrait: {fileID: 21300000, guid: bc24db65733a418297d3306489a4cb63, type: 3}

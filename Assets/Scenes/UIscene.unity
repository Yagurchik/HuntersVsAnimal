--- !u!114 &1849321648
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1849321646}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d15edf97fa82d43408bc8472c1ab5be6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  section: 2
  entryTitle: "\u041C\u0435\u0434\u043E\u0435\u0434"
  entrySubtitle: "\u0426\u0415\u041F\u041D\u0410\u042F \u041E\u0425\u041E\u0422\u0410"
  entryBody: "\u041F\u0440\u044B\u0433\u0430\u0435\u0442 \u043A \u043D\u0430\u0438\u0431\u043E\u043B\u0435\u0435
    \u0440\u0430\u043D\u0435\u043D\u043E\u043C\u0443 \u0432\u0440\u0430\u0433\u0443
    \u0432 \u0440\u0430\u0434\u0438\u0443\u0441\u0435 \u0430\u0442\u0430\u043A\u0438.
    \u0423\u0431\u0438\u0439\u0441\u0442\u0432\u0430 \u043F\u0440\u043E\u0434\u043E\u043B\u0436\u0430\u044E\u0442
    \u0446\u0435\u043F\u044C \u0438 \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u044E\u0442
    \u0434\u0430\u043B\u044C\u043D\u0435\u0439\u0448\u0438\u0435 \u0443\u0434\u0430\u0440\u044B.\n\n\u0422\u0410\u041B\u0410\u041D\u0422\u042B\n\u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u2014 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0441\u043D\u0430\u0440\u044F\u0434
    \u0438 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u0435\u0433\u043E
    \u0437\u0430\u043F\u0430\u0441 \u0437\u0430 \u0437\u0430\u043B\u043F.\n\n\u0420\u0430\u0434\u0438\u0443\u0441
    \u0430\u0442\u0430\u043A\u0438 \u2014 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442
    \u0434\u0430\u043B\u044C\u043D\u043E\u0441\u0442\u044C \u043F\u0440\u044B\u0436\u043A\u0430
    \u043A \u0446\u0435\u043B\u0438.\n\n\u042F\u0440\u043E\u0441\u0442\u043D\u0430\u044F
    \u0446\u0435\u043F\u044C \u2014 \u0431\u043E\u043B\u044C\u0448\u0435 \u0430\u0442\u0430\u043A
    \u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u044B\u0445 \u0443\u0434\u0430\u0440\u043E\u0432
    \u043F\u043E \u043E\u0434\u043D\u043E\u043C\u0443 \u0432\u0440\u0430\u0433\u0443.\n\n\u0423\u043B\u044C\u0442\u0430
    \xAB\u0410\u0431\u0441\u043E\u043B\u044E\u0442\u043D\u0430\u044F \u044F\u0440\u043E\u0441\u0442\u044C\xBB
    \u2014 \u043A\u0430\u0436\u0434\u044B\u0439 \u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0439
    \u0443\u0434\u0430\u0440 \u043F\u043E\u043B\u0443\u0447\u0430\u0435\u0442 \u0435\u0449\u0451
    +10 \u0443\u0440\u043E\u043D\u0430.\n\n\u0423\u043B\u044C\u0442\u0430 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043F\u043E\u0441\u043B\u0435 \u043F\u0440\u043E\u043A\u0430\u0447\u043A\u0438
    \u0432\u0441\u0435\u0445 \u0442\u0440\u0451\u0445 \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0445
    \u0432\u0435\u0442\u043E\u043A \u0434\u043E III \u0440\u0430\u043D\u0433\u0430."
  portrait: {fileID: 21300000, guid: 30d72c47bedcc804389ff3d020592854, type: 3}

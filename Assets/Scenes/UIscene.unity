--- !u!114 &1294390733
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1294390731}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d15edf97fa82d43408bc8472c1ab5be6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  section: 1
  entryTitle: "\u0421\u043D\u0435\u0433\u043E\u0432\u043E\u0439 \u0434\u0432\u043E\u0439\u043D\u0438\u043A"
  entrySubtitle: "\u0421\u043D\u0435\u0436\u043D\u0430\u044F \u043C\u0433\u043B\u0430 
    \xB7  \u0421\u041F\u0415\u0426\u0418\u0410\u041B\u0418\u0421\u0422"
  entryBody: "\u0412 \u043B\u0435\u0434\u044F\u043D\u043E\u0439 \u0444\u043E\u0440\u043C\u0435
    \u043E\u0434\u0438\u043D \u0440\u0430\u0437 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0435\u0442
    \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043F\u0440\u044F\u043C\u043E\u0439
    \u0443\u0434\u0430\u0440 \u0441 1 HP.\n\n\u041E\u0421\u041E\u0411\u0415\u041D\u041D\u041E\u0421\u0422\u042C\n\u0412
    \u043B\u0435\u0434\u044F\u043D\u043E\u0439 \u0444\u043E\u0440\u043C\u0435 \u043E\u0434\u0438\u043D
    \u0440\u0430\u0437 \u043F\u0435\u0440\u0435\u0436\u0438\u0432\u0430\u0435\u0442
    \u0441\u043C\u0435\u0440\u0442\u0435\u043B\u044C\u043D\u044B\u0439 \u043F\u0440\u044F\u043C\u043E\u0439
    \u0443\u0434\u0430\u0440 \u0441 1 HP. \u042F\u0434 \u0438 \u043E\u0433\u043E\u043D\u044C
    \u0434\u043E\u0431\u0438\u0432\u0430\u044E\u0442 \u0435\u0433\u043E \u043E\u0431\u044B\u0447\u043D\u043E.\n\n\u041E\u0411\u042B\u0427\u041D\u042B\u0419
    \u0412\u0420\u0410\u0413\n\u0420\u0430\u0437\u043C\u0435\u0440 \u043D\u0430 \u043F\u043E\u043B\u0435:
    1\xD71\n\u0411\u0430\u0437\u043E\u0432\u043E\u0435 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435:
    100\n\n\u0417\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u0440\u0430\u0441\u0442\u0451\u0442
    \u0441 \u0443\u0440\u043E\u0432\u043D\u0435\u043C \u0438 \u0432\u043E\u043B\u043D\u043E\u0439."
  portrait: {fileID: 21300000, guid: 8d74ce1d4dc9497eab64afc1f97eca03, type: 3}

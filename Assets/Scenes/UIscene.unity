--- !u!114 &1871003791
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1871003789}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d15edf97fa82d43408bc8472c1ab5be6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  section: 2
  entryTitle: "\u0411\u0435\u043B\u043E\u0447\u043A\u0430"
  entrySubtitle: "\u0416\u0401\u041B\u0423\u0414\u0418 \u0418 \u041B\u041E\u0417\u042B"
  entryBody: "\u041E\u0441\u0442\u0430\u0432\u043B\u044F\u0435\u0442 \u0436\u0451\u043B\u0443\u0434\u0438.
    \u041E\u043D\u0438 \u0432\u0437\u0440\u044B\u0432\u0430\u044E\u0442\u0441\u044F
    \u043F\u0440\u0438 \u0433\u0438\u0431\u0435\u043B\u0438 \u0432\u0440\u0430\u0433\u0430
    \u0438 \u043C\u043E\u0433\u0443\u0442 \u043E\u043F\u0443\u0442\u044B\u0432\u0430\u0442\u044C
    \u0441\u043E\u0441\u0435\u0434\u0435\u0439 \u043B\u043E\u0437\u0430\u043C\u0438.\n\n\u0422\u0410\u041B\u0410\u041D\u0422\u042B\n\u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u2014 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0441\u043D\u0430\u0440\u044F\u0434
    \u0438 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u0435\u0433\u043E
    \u0437\u0430\u043F\u0430\u0441 \u0437\u0430 \u0437\u0430\u043B\u043F.\n\n\u0420\u0430\u043D\u043D\u0438\u0439
    \u0432\u0437\u0440\u044B\u0432 \u2014 \u043F\u043E\u0432\u044B\u0448\u0430\u0435\u0442
    \u0448\u0430\u043D\u0441 \u0432\u0437\u0440\u044B\u0432\u0430 \u0436\u0451\u043B\u0443\u0434\u044F
    \u043F\u0440\u0438 \u043F\u043E\u0432\u0442\u043E\u0440\u043D\u043E\u043C \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u0438.\n\n\u041B\u0435\u0441\u043D\u044B\u0435
    \u043F\u0443\u0442\u044B \u2014 \u0432\u0437\u0440\u044B\u0432 \u043C\u043E\u0436\u0435\u0442
    \u043E\u0431\u0435\u0437\u0434\u0432\u0438\u0436\u0438\u0442\u044C \u0432\u0440\u0430\u0433\u043E\u0432
    \u043D\u0430 \u043E\u0434\u0438\u043D \u0445\u043E\u0434.\n\n\u0423\u043B\u044C\u0442\u0430
    \xAB\u0426\u0435\u043F\u043D\u0430\u044F \u0440\u0435\u0430\u043A\u0446\u0438\u044F\xBB
    \u2014 \u0432\u0437\u0440\u044B\u0432\u044B \u043F\u043E\u0434\u0440\u044B\u0432\u0430\u044E\u0442
    \u0441\u043E\u0441\u0435\u0434\u043D\u0438\u0435 \u0436\u0451\u043B\u0443\u0434\u0438.\n\n\u0423\u043B\u044C\u0442\u0430
    \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043F\u043E\u0441\u043B\u0435
    \u043F\u0440\u043E\u043A\u0430\u0447\u043A\u0438 \u0432\u0441\u0435\u0445 \u0442\u0440\u0451\u0445
    \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0445 \u0432\u0435\u0442\u043E\u043A
    \u0434\u043E III \u0440\u0430\u043D\u0433\u0430."
  portrait: {fileID: 21300000, guid: 2983fccaf24943c78523e542489d5c5b, type: 3}

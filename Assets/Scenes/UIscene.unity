--- !u!114 &648749743
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 648749741}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d15edf97fa82d43408bc8472c1ab5be6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  section: 2
  entryTitle: "\u0421\u0432\u0435\u0442\u043B\u044F\u0447\u043E\u043A"
  entrySubtitle: "\u0421\u0412\u0415\u0422 \u0418 \u0413\u041E\u0420\u0415\u041D\u0418\u0415"
  entryBody: "\u041E\u0441\u0432\u0435\u0449\u0430\u0435\u0442 \u0442\u0451\u043C\u043D\u044B\u0435
    \u043A\u043B\u0435\u0442\u043A\u0438 \u0438 \u043F\u043E\u0434\u0436\u0438\u0433\u0430\u0435\u0442
    \u0432\u0440\u0430\u0433\u043E\u0432. \u041F\u043E\u0432\u0442\u043E\u0440\u043D\u044B\u0435
    \u0437\u0430\u043B\u043F\u044B \u043F\u043E\u0437\u0432\u043E\u043B\u044F\u044E\u0442
    \u0440\u0430\u0437\u043D\u0435\u0441\u0442\u0438 \u043E\u0433\u043E\u043D\u044C
    \u043F\u043E \u043A\u043E\u043C\u043D\u0430\u0442\u0435.\n\n\u0422\u0410\u041B\u0410\u041D\u0422\u042B\n\u0421\u0432\u0435\u0442\u043B\u044F\u0447\u043E\u043A
    \u0432\u0441\u0435\u0433\u0434\u0430 \u0432\u044B\u043F\u0443\u0441\u043A\u0430\u0435\u0442
    5 \u0441\u043D\u0430\u0440\u044F\u0434\u043E\u0432 \u0437\u0430 \u0437\u0430\u043B\u043F.\n\n\u041F\u043E\u0432\u0442\u043E\u0440\u043D\u044B\u0439
    \u0437\u0430\u043B\u043F \u2014 \u0431\u043E\u043B\u044C\u0448\u0435 \u0440\u0443\u0447\u043D\u044B\u0445
    \u0437\u0430\u043B\u043F\u043E\u0432 \u0437\u0430 \u0445\u043E\u0434; \u0443\u0440\u043E\u043D
    \u043F\u043E\u0441\u043B\u0435\u0434\u0443\u044E\u0449\u0438\u0445 \u0437\u0430\u043B\u043F\u043E\u0432
    \u0437\u0430\u0432\u0438\u0441\u0438\u0442 \u043E\u0442 \u0440\u0430\u043D\u0433\u0430.\n\n\u0413\u043E\u0440\u0435\u043D\u0438\u0435
    \u2014 \u0441\u0438\u043B\u044C\u043D\u0435\u0435 \u0443\u0440\u043E\u043D \u043A\u0430\u0436\u0434\u043E\u0433\u043E
    \u0441\u0442\u0430\u043A\u0430 \u043E\u0433\u043D\u044F \u0437\u0430 \u0445\u043E\u0434.\n\n\u0423\u043B\u044C\u0442\u0430
    \xAB\u0412\u0435\u0447\u043D\u044B\u0439 \u043E\u0433\u043E\u043D\u044C\xBB \u2014
    \u0441\u0442\u0430\u043A\u0438 \u0431\u043E\u043B\u044C\u0448\u0435 \u043D\u0435
    \u0438\u0441\u0447\u0435\u0437\u0430\u044E\u0442, \u0438\u0445 \u043A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u043D\u0435 \u043E\u0433\u0440\u0430\u043D\u0438\u0447\u0435\u043D\u043E.\n\n\u0423\u043B\u044C\u0442\u0430
    \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043F\u043E\u0441\u043B\u0435
    \u043F\u0440\u043E\u043A\u0430\u0447\u043A\u0438 \u0434\u0432\u0443\u0445 \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0445
    \u0432\u0435\u0442\u043E\u043A \u0434\u043E III \u0440\u0430\u043D\u0433\u0430."
  portrait: {fileID: 21300000, guid: 25b732fd913545fcbb8806258aa7f1ee, type: 3}

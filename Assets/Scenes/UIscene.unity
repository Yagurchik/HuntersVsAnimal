--- !u!114 &324767409
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 324767407}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d15edf97fa82d43408bc8472c1ab5be6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  section: 0
  entryTitle: "\u0413\u0435\u0435\u043D\u043D\u0430 \u043E\u0433\u043D\u0435\u043D\u043D\u0430\u044F"
  entrySubtitle: "\u0413\u041B\u0410\u0412\u0410 6  \xB7  5 \u0423\u0420\u041E\u0412\u041D\u0415\u0419"
  entryBody: "\u041E\u0433\u043D\u0435\u043D\u043D\u044B\u0435 \u0442\u0432\u0430\u0440\u0438
    \u0441\u043E\u0447\u0435\u0442\u0430\u044E\u0442 \u0441\u043E\u043F\u0440\u043E\u0442\u0438\u0432\u043B\u0435\u043D\u0438\u0435
    \u043E\u0433\u043D\u044E, \u043A\u043B\u0435\u0439\u043C\u0430 \u0438 \u0432\u0437\u0440\u044B\u0432\u044B.
    \u041F\u043E\u0440\u044F\u0434\u043E\u043A \u0443\u0434\u0430\u0440\u043E\u0432
    \u043E\u0441\u043E\u0431\u0435\u043D\u043D\u043E \u0432\u0430\u0436\u0435\u043D.\n\n\u041E\u0411\u042B\u0427\u041D\u042B\u0415
    \u0412\u0420\u0410\u0413\u0418\n\u0423\u0433\u043E\u043B\u044C\u043D\u0430\u044F
    \u043C\u0430\u0441\u043A\u0430  \xB7  \u0428\u043B\u0430\u043A\u043E\u0432\u0438\u043A 
    \xB7  \u0416\u0430\u0440\u043E\u0432\u0438\u043A  \xB7  \u041F\u0435\u043F\u0435\u043B\u044C\u043D\u044B\u0439
    \u0441\u0431\u043E\u0440\u0449\u0438\u043A  \xB7  \u041A\u043B\u0435\u0439\u043C\u0438\u0442\u0435\u043B\u044C\n\n\u0411\u041E\u0421\u0421\u042B
    \u0418 \u041C\u0418\u041D\u0418-\u0411\u041E\u0421\u0421\u042B\n\u041F\u043E\u0436\u0438\u0440\u0430\u0442\u0435\u043B\u044C
    \u0437\u0430\u043B\u043F\u0430  \xB7  \u041A\u043E\u0441\u0442\u044F\u043D\u043E\u0439
    \u044D\u043B\u044C\u0444  \xB7  \u041A\u043E\u043B\u043E\u043A\u043E\u043B\u044C\u0449\u0438\u043A 
    \xB7  \u0423\u0437\u043B\u043E\u0432\u0438\u043A  \xB7  \u0422\u0440\u0451\u0445\u043F\u0435\u0447\u0430\u0442\u043D\u044B\u0439
    \u0438\u0434\u043E\u043B\n\n\u041A\u0430\u0436\u0434\u044B\u0439 \u0443\u0440\u043E\u0432\u0435\u043D\u044C
    \u0441\u043E\u0434\u0435\u0440\u0436\u0438\u0442 \u0447\u0435\u0442\u044B\u0440\u0435
    \u043B\u0438\u043D\u0438\u0438 \u043E\u0431\u043E\u0440\u043E\u043D\u044B. \u041D\u0430
    \u043B\u0438\u043D\u0438\u044F\u0445 2\u20134 \u043E\u0441\u0432\u0435\u0449\u0435\u043D\u0438\u0435
    \u0441\u043B\u0430\u0431\u0435\u0435; \u0421\u0432\u0435\u0442\u043B\u044F\u0447\u043E\u043A
    \u0440\u0430\u0441\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0442\u0451\u043C\u043D\u044B\u0435
    \u043A\u043B\u0435\u0442\u043A\u0438."
  portrait: {fileID: 21300000, guid: 93eff06dd17946c089ffce59bd536820, type: 3}

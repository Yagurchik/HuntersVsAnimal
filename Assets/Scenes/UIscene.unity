--- !u!114 &2106922211
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2106922209}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d15edf97fa82d43408bc8472c1ab5be6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  section: 2
  entryTitle: "\u0411\u043E\u0431\u0440"
  entrySubtitle: "\u041F\u041B\u041E\u0422\u0418\u041D\u0410 \u0418 \u0423\u041A\u0423\u0421\u042B"
  entryBody: "\u041F\u043E\u043C\u043E\u0433\u0430\u0435\u0442 \u0437\u0430\u0449\u0438\u0449\u0430\u0442\u044C
    \u043F\u043B\u043E\u0442\u0438\u043D\u0443 \u0438 \u0431\u0430\u0440\u0440\u0438\u043A\u0430\u0434\u0443;
    \u043A\u0443\u0441\u0430\u0435\u0442 \u0432\u0440\u0430\u0433\u043E\u0432 \u0438
    \u0443\u0441\u0438\u043B\u0438\u0432\u0430\u0435\u0442 \u0437\u0430\u0449\u0438\u0442\u0443
    \u043D\u0430\u043D\u0435\u0441\u0451\u043D\u043D\u044B\u043C \u0443\u0440\u043E\u043D\u043E\u043C.\n\n\u0422\u0410\u041B\u0410\u041D\u0422\u042B\n\u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u2014 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0441\u043D\u0430\u0440\u044F\u0434
    \u0438 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u0435\u0433\u043E
    \u0437\u0430\u043F\u0430\u0441 \u0437\u0430 \u0437\u0430\u043B\u043F.\n\n\u041A\u0440\u0435\u043F\u043A\u0430\u044F
    \u043F\u043B\u043E\u0442\u0438\u043D\u0430 \u2014 \u0431\u043E\u043B\u044C\u0448\u0430\u044F
    \u0434\u043E\u043B\u044F \u043D\u0430\u043D\u0435\u0441\u0451\u043D\u043D\u043E\u0433\u043E
    \u0443\u0440\u043E\u043D\u0430 \u043F\u0440\u0435\u0432\u0440\u0430\u0449\u0430\u0435\u0442\u0441\u044F
    \u0432 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u0437\u0430\u0449\u0438\u0442\u044B.\n\n\u041A\u0440\u0435\u043F\u043A\u0438\u0435
    \u0437\u0443\u0431\u044B \u2014 \u0431\u043E\u043B\u044C\u0448\u0435 \u0443\u0440\u043E\u043D\u0430
    \u0437\u0430 \u0443\u043A\u0443\u0441.\n\n\u0423\u043B\u044C\u0442\u0430 \xAB\u041E\u0442\u0441\u043A\u043E\u043A
    \u043E\u0442 \u0442\u044B\u043A\u0432\u044B\xBB \u2014 \u043E\u0434\u0438\u043D
    \u0434\u043E\u043F\u043E\u043B\u043D\u0438\u0442\u0435\u043B\u044C\u043D\u044B\u0439
    \u043E\u0442\u0441\u043A\u043E\u043A \u043E\u0442 \u043F\u043E\u043B\u044F \u0442\u044B\u043A\u0432\u044B.\n\n\u0423\u043B\u044C\u0442\u0430
    \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F \u043F\u043E\u0441\u043B\u0435
    \u043F\u0440\u043E\u043A\u0430\u0447\u043A\u0438 \u0432\u0441\u0435\u0445 \u0442\u0440\u0451\u0445
    \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0445 \u0432\u0435\u0442\u043E\u043A
    \u0434\u043E III \u0440\u0430\u043D\u0433\u0430."
  portrait: {fileID: 21300000, guid: 574b02c09aa7491584ff419283c2352a, type: 3}

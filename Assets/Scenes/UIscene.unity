--- !u!114 &1030583368
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1030583366}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d15edf97fa82d43408bc8472c1ab5be6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  section: 2
  entryTitle: "\u0401\u0436"
  entrySubtitle: "\u0412\u0417\u0420\u042B\u0412 \u041F\u041E \u041E\u0411\u041B\u0410\u0421\u0422\u0418"
  entryBody: "\u0412\u0437\u0440\u044B\u0432\u0430\u0435\u0442\u0441\u044F \u043F\u0440\u0438
    \u0441\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u0438 \u0438
    \u043D\u0430\u043D\u043E\u0441\u0438\u0442 \u0443\u0440\u043E\u043D \u0432\u0440\u0430\u0433\u0430\u043C
    \u0432\u043E\u043A\u0440\u0443\u0433 \u0442\u043E\u0447\u043A\u0438 \u0443\u0434\u0430\u0440\u0430.\n\n\u0422\u0410\u041B\u0410\u041D\u0422\u042B\n\u041A\u043E\u043B\u0438\u0447\u0435\u0441\u0442\u0432\u043E
    \u2014 \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u0435\u0442 \u0441\u043D\u0430\u0440\u044F\u0434
    \u0438 \u0443\u0432\u0435\u043B\u0438\u0447\u0438\u0432\u0430\u0435\u0442 \u0435\u0433\u043E
    \u0437\u0430\u043F\u0430\u0441 \u0437\u0430 \u0437\u0430\u043B\u043F.\n\n\u0420\u0430\u0434\u0438\u0443\u0441
    \u0432\u0437\u0440\u044B\u0432\u0430 \u2014 \u0440\u0430\u0441\u0448\u0438\u0440\u044F\u0435\u0442
    \u043E\u0431\u043B\u0430\u0441\u0442\u044C \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F.\n\n\u041E\u0441\u0442\u0440\u044B\u0435
    \u0438\u0433\u043E\u043B\u043A\u0438 \u2014 \u043A\u0430\u0436\u0434\u044B\u0439
    \u0432\u0437\u0440\u044B\u0432 \u0432 \u044D\u0442\u043E\u043C \u0445\u043E\u0434\u0443
    \u043D\u0430\u0440\u0430\u0449\u0438\u0432\u0430\u0435\u0442 \u0443\u0440\u043E\u043D
    \u043F\u043E \u0432\u0440\u0430\u0433\u0443.\n\n\u0423\u043B\u044C\u0442\u0430
    \xAB\u0414\u0432\u043E\u0439\u043D\u043E\u0439 \u0437\u0430\u043B\u043F\xBB \u2014
    \u043F\u0440\u0438 \u0441\u0442\u043E\u043B\u043A\u043D\u043E\u0432\u0435\u043D\u0438\u0438
    \u0441\u043B\u0435\u0434\u043E\u043C \u0437\u0430 \u043F\u0435\u0440\u0432\u044B\u043C
    \u043F\u0440\u043E\u0438\u0441\u0445\u043E\u0434\u0438\u0442 \u0432\u0442\u043E\u0440\u043E\u0439
    \u0432\u0437\u0440\u044B\u0432.\n\n\u0423\u043B\u044C\u0442\u0430 \u043F\u043E\u044F\u0432\u043B\u044F\u0435\u0442\u0441\u044F
    \u043F\u043E\u0441\u043B\u0435 \u043F\u0440\u043E\u043A\u0430\u0447\u043A\u0438
    \u0432\u0441\u0435\u0445 \u0442\u0440\u0451\u0445 \u043E\u0441\u043D\u043E\u0432\u043D\u044B\u0445
    \u0432\u0435\u0442\u043E\u043A \u0434\u043E III \u0440\u0430\u043D\u0433\u0430."
  portrait: {fileID: 21300000, guid: 8af985f19c9e4e2e90e0cce88614d4d7, type: 3}

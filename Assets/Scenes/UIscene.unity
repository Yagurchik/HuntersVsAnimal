--- !u!114 &2013820349
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 2013820347}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d15edf97fa82d43408bc8472c1ab5be6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  section: 1
  entryTitle: "\u041A\u043E\u0440\u043E\u0441\u0442\u0440\u0430\u0436"
  entrySubtitle: "\u0421\u0443\u043C\u0435\u0440\u0435\u0447\u043D\u0430\u044F \u0447\u0430\u0449\u0430 
    \xB7  \u0421\u041F\u0415\u0426\u0418\u0410\u041B\u0418\u0421\u0422"
  entryBody: "\u041A\u043E\u0440\u0430 \u043D\u0430 \u0432\u0435\u0440\u0445\u043D\u0435\u0439
    \u0447\u0430\u0441\u0442\u0438 \u0433\u043E\u043B\u043E\u0432\u044B \u0441\u043D\u0438\u0436\u0430\u0435\u0442
    \u0443\u0440\u043E\u043D \u043F\u0440\u044F\u043C\u043E\u0433\u043E \u043F\u043E\u043F\u0430\u0434\u0430\u043D\u0438\u044F
    \u0434\u043E 70%.\n\n\u041E\u0421\u041E\u0411\u0415\u041D\u041D\u041E\u0421\u0422\u042C\n\u0423\u0434\u0430\u0440
    \u043F\u043E \u0432\u0435\u0440\u0445\u043D\u0435\u0439 \u0447\u0430\u0441\u0442\u0438
    \u0433\u043E\u043B\u043E\u0432\u044B \u043D\u0430\u043D\u043E\u0441\u0438\u0442
    70% \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E \u043F\u0440\u044F\u043C\u043E\u0433\u043E
    \u0443\u0440\u043E\u043D\u0430. \u041F\u043E \u043E\u0442\u043A\u0440\u044B\u0442\u043E\u0439
    \u0447\u0435\u043B\u044E\u0441\u0442\u0438 \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
    \u043F\u043E\u043B\u043D\u044B\u0439 \u0443\u0440\u043E\u043D.\n\n\u041E\u0411\u042B\u0427\u041D\u042B\u0419
    \u0412\u0420\u0410\u0413\n\u0420\u0430\u0437\u043C\u0435\u0440 \u043D\u0430 \u043F\u043E\u043B\u0435:
    1\xD71\n\u0411\u0430\u0437\u043E\u0432\u043E\u0435 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435:
    100\n\n\u0417\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u0440\u0430\u0441\u0442\u0451\u0442
    \u0441 \u0443\u0440\u043E\u0432\u043D\u0435\u043C \u0438 \u0432\u043E\u043B\u043D\u043E\u0439."
  portrait: {fileID: 21300000, guid: d53efce04b6d42489f9c0a7bd8eebd55, type: 3}

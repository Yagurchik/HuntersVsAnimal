  entryTitle: "\u041F\u0440\u0438\u0437\u0440\u0430\u043A"
  entrySubtitle: "\u041C\u0440\u0430\u0447\u043D\u0430\u044F \u043B\u043E\u0449\u0438\u043D\u0430 
    \xB7  \u0421\u041F\u0415\u0426\u0418\u0410\u041B\u0418\u0421\u0422"
  entryBody: "\u0418\u043C\u0435\u0435\u0442 80% \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u044F
    \u043E\u0431\u044B\u0447\u043D\u043E\u0433\u043E \u0432\u0440\u0430\u0433\u0430.
    \u041A\u0430\u0436\u0434\u044B\u0439 \u0441\u043D\u0430\u0440\u044F\u0434 \u0441
    \u0448\u0430\u043D\u0441\u043E\u043C 20% \u043F\u0440\u043E\u0445\u043E\u0434\u0438\u0442
    \u0441\u043A\u0432\u043E\u0437\u044C \u043D\u0435\u0433\u043E; \u0443\u0436\u0435
    \u043D\u0430\u043B\u043E\u0436\u0435\u043D\u043D\u044B\u0439 \u043E\u0433\u043E\u043D\u044C
    \u043E\u043D \u043D\u0435 \u0438\u0437\u0431\u0435\u0433\u0430\u0435\u0442.\n\n\u041E\u0411\u042B\u0427\u041D\u042B\u0419
    \u0412\u0420\u0410\u0413\n\u0420\u0430\u0437\u043C\u0435\u0440 \u043D\u0430 \u043F\u043E\u043B\u0435:
    1\xD71\n\u0411\u0430\u0437\u043E\u0432\u043E\u0435 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435:
    80\n\n\u0417\u0434\u043E\u0440\u043E\u0432\u044C\u0435 \u0440\u0430\u0441\u0442\u0451\u0442
    \u0441 \u0443\u0440\u043E\u0432\u043D\u0435\u043C \u0438 \u0432\u043E\u043B\u043D\u043E\u0439."
  portrait: {fileID: 21300000, guid: bf453d5965ae41a1a760b381c7160828, type: 3}

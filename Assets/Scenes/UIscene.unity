    m_VerticalOverflow: 0
    m_LineSpacing: 1
  m_Text: "\u0422\u0435\u0441\u0442\u043E\u0432\u044B\u0435 \u0437\u0430\u0431\u0435\u0433\u0438
    \u043E\u0442\u043A\u0440\u044B\u0432\u0430\u044E\u0442 \u0432\u0441\u0435 \u043A\u043E\u043C\u043D\u0430\u0442\u044B
    \u0438 \u0443\u0440\u043E\u0432\u043D\u0438.\n\u041F\u0440\u043E\u0433\u0440\u0435\u0441\u0441
    \u0438 \u043D\u0430\u0433\u0440\u0430\u0434\u044B \u0432 \u043D\u0438\u0445 \u043D\u0435
    \u0441\u043E\u0445\u0440\u0430\u043D\u044F\u044E\u0442\u0441\u044F."

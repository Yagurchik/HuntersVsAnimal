--- !u!114 &222092527
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 222092525}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: d15edf97fa82d43408bc8472c1ab5be6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  section: 1
  entryTitle: "\u041B\u0435\u0441\u043D\u043E\u0439 \u0441\u043A\u0435\u043B\u0435\u0442"
  entrySubtitle: "\u0421\u0443\u043C\u0435\u0440\u0435\u0447\u043D\u0430\u044F \u0447\u0430\u0449\u0430 
    \xB7  \u0420\u042F\u0414\u041E\u0412\u041E\u0419"
  entryBody: "\u0428\u0430\u0433\u0430\u0435\u0442 \u043A \u043B\u0438\u043D\u0438\u0438
    \u043F\u043E\u0440\u0430\u0436\u0435\u043D\u0438\u044F \u043D\u0430 \u043E\u0434\u043D\u0443
    \u043A\u043B\u0435\u0442\u043A\u0443 \u0437\u0430 \u0445\u043E\u0434. \u041E\u0441\u0442\u0430\u043D\u043E\u0432\u0438
    \u0435\u0433\u043E \u0434\u043E \u043F\u0440\u043E\u0440\u044B\u0432\u0430.\n\n\u041E\u0411\u042B\u0427\u041D\u042B\u0419
    \u0412\u0420\u0410\u0413\n\u0420\u0430\u0437\u043C\u0435\u0440 \u043D\u0430 \u043F\u043E\u043B\u0435:
    1\xD71\n\u0411\u0430\u0437\u043E\u0432\u043E\u0435 \u0437\u0434\u043E\u0440\u043E\u0432\u044C\u0435:
